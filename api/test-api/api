server {
	listen 443 ssl;
	server_name api.blocktrustnetwork.com;
	ssl_certificate /etc/letsencrypt/live/api.dev.blocktrustnetwork.com/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/api.dev.blocktrustnetwork.com/privkey.pem;


	location / {
		include uwsgi_params;
		client_max_body_size 100M;
		proxy_read_timeout 300s;
		proxy_connect_timeout 300s;
		proxy_send_timeout 300s;
		uwsgi_read_timeout 300s;
		uwsgi_pass unix:///home/ubuntu/test-api/uwsgi.sock;
	}
}
