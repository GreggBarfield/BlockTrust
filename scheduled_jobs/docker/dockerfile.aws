FROM python:3.9-buster

# Install stuff
RUN apt update -y && apt upgrade -y

# Set temporary install dir
WORKDIR /home/ubuntu/install

# Finish installing
COPY scheduled_jobs/docker/requirements.txt .
RUN python3 -m pip install -r requirements.txt

COPY core/config.py /home/ubuntu/blocktrust/core/config.py
COPY core/sectors.py /home/ubuntu/blocktrust/core/sectors.py
COPY core/common_exceptions.py /home/ubuntu/blocktrust/core/common_exceptions.py
COPY core/match_types.py /home/ubuntu/blocktrust/core/match_types.py
COPY core/environment_config.json /home/ubuntu/blocktrust/core/environment_config.json
COPY core/database /home/ubuntu/blocktrust/core/database
COPY core/utilities /home/ubuntu/blocktrust/core/utilities
COPY scheduled_jobs /home/ubuntu/blocktrust/scheduled_jobs

# Set app dir
WORKDIR /home/ubuntu/blocktrust

# Help Python with local imports
ENV PYTHONPATH /home/ubuntu/blocktrust

# Run
CMD exec python3 scheduled_jobs/main.py