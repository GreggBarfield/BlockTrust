# Use -ca so that Certificate Authorities is used to generate certificates
# Use -s couchdb to use CouchDB as our database. The default is leveldb
./network.sh up -ca -s couchdb
# Create a channel named channel1
./network.sh createChannel -c admin-channel

# uses the chaincode lifecycle to package, install, query installed chaincode, approve chaincode for Org1,
# and finally commit the chaincode.
./network.sh deployCC -c admin-channel -ccn basic -ccp ../record-management-basic/chaincode-javascript/ -ccl javascript


