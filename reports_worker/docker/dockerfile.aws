FROM python:3.9-buster

# Install stuff
RUN apt update -y && apt upgrade -y

# Set temporary install dir
WORKDIR /home/ubuntu/install

# Finish installing

COPY reports_worker/docker/requirements.txt .
RUN python3 -m pip install -r requirements.txt

# Copy application code
COPY core /home/ubuntu/blocktrust/core
COPY reports_worker /home/ubuntu/blocktrust/reports_worker

# Set app dir
WORKDIR /home/ubuntu/blocktrust

# Run
CMD exec python3 reports_worker/main.py
