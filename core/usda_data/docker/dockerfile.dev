FROM python:3.9-buster

# Install stuff
RUN apt update -y && apt upgrade -y

# Set default dir
WORKDIR /home/ubuntu

# Finish installing

COPY requirements.txt .
RUN python3 -m pip install -r requirements.txt

# Set app dir
WORKDIR /home/ubuntu
COPY ../get-data.py .

# Run
CMD exec python3 get_data.py
